../../clock_udp.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile ..\..\clock_udp.pro -spec win32-g++ "CONFIG+=debug" "CONFIG+=qml_debug"

qmake_all: sub-common-qmake_all sub-server-qmake_all sub-client-qmake_all FORCE

make_first: sub-common-make_first sub-server-make_first sub-client-make_first  FORCE
all: sub-common-all sub-server-all sub-client-all  FORCE
clean: sub-common-clean sub-server-clean sub-client-clean  FORCE
distclean: sub-common-distclean sub-server-distclean sub-client-distclean  FORCE
	-$(DEL_FILE) Makefile
	-$(DEL_FILE) .qmake.stash
install_subtargets: sub-common-install_subtargets sub-server-install_subtargets sub-client-install_subtargets FORCE
uninstall_subtargets: sub-common-uninstall_subtargets sub-server-uninstall_subtargets sub-client-uninstall_subtargets FORCE

sub-common-debug:
	@if not exist common\ mkdir common\ & if not exist common\ exit 1
	cd common\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\GitHUB_Qt\clock_udp\common\common.pro -spec win32-g++ "CONFIG+=debug" "CONFIG+=qml_debug" ) && $(MAKE) -f Makefile debug
sub-server-debug: sub-common-debug
	@if not exist server\ mkdir server\ & if not exist server\ exit 1
	cd server\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\GitHUB_Qt\clock_udp\server\server.pro -spec win32-g++ "CONFIG+=debug" "CONFIG+=qml_debug" ) && $(MAKE) -f Makefile debug
sub-client-debug: sub-common-debug
	@if not exist client\ mkdir client\ & if not exist client\ exit 1
	cd client\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\GitHUB_Qt\clock_udp\client\client.pro -spec win32-g++ "CONFIG+=debug" "CONFIG+=qml_debug" ) && $(MAKE) -f Makefile debug
debug: sub-common-debug sub-server-debug sub-client-debug

